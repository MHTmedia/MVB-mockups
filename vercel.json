{
  "buildCommand": "node tools/build.mjs",
  "outputDirectory": "public",
  "installCommand": "",
  "framework": null,
  "trailingSlash": true,
  "redirects": [
    { "source": "/pdp-product-overview/:path*", "destination": "/cro-005-pdp-product-overview/:path*", "permanent": false },
    { "source": "/shop-by-scent/:path*", "destination": "/cro-017-shop-by-scent/:path*", "permanent": false },
    { "source": "/shop-by-goal/:path*", "destination": "/cro-021-homepage-guided-shopping/:path*", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/_shared/(js|fonts|img)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
